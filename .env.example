# Google Docs API Configuration (Server-side only)
# ID of the Google Doc containing the vocabulary
GOOGLE_DOC_ID=your_google_doc_id_here # link docs

# Service Account Email from Google Cloud Console
GOOGLE_SERVICE_ACCOUNT_EMAIL=your_service_account@your-project.iam.gserviceaccount.com # google cloud console

# Service Account Private Key (include BEGIN and END lines, handle \n properly)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n" # google cloud console

# Google Gemini API Key for AI Chatbot
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: Gemini Model (Default: gemini-2.0-flash-lite)
GEMINI_MODEL=gemini-2.0-flash-lite

# Mẫu env cần điền nếu muốn chạy