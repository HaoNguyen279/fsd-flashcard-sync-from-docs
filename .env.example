# Google Docs API Configuration (Server-side only)
# ID of the Google Doc containing the vocabulary
GOOGLE_DOC_ID=your_google_doc_id_here

# Service Account Email from Google Cloud Console
GOOGLE_SERVICE_ACCOUNT_EMAIL=your_service_account@your-project.iam.gserviceaccount.com

# Service Account Private Key (include BEGIN and END lines, handle \n properly)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
